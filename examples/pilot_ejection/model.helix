HELIX 1

PROJECT "PILOT EJECTION"

VAR X AS "X POS" RANGE -70..30
VAR Y AS "Y POS" RANGE 0..20
VAR V AS "SPEED" RANGE 0..1000
VAR THETA AS "THETA" RANGE 0..1
VAR LEFT_COCKPIT AS "LEFT COCKPIT"

CONTINUOUS METHOD=RKF45, MIN_STEP=0.0001, SAVE_STEP=0.01, MAX_STEP=0.01

; 到达边界后终止；离开座舱后切换为自由飞行方程。
SEVNT code=1, when=X < -60
SEVNT code=1, when=Y > 30
SEVNT name=LEFT, code=2, when=Y > 4, action=SET_LEFT

EQUATION
  DD(X) = V * COS(THETA) - VA
  DD(Y) = V * SIN(THETA)
  DD(V) = IF(LEFT_COCKPIT < 1, 0.0,
             -(0.5 * RHO * CD * XS * V * V) / XM - G * SIN(THETA))
  DD(THETA) = IF(LEFT_COCKPIT < 1, 0.0,
                 -G * COS(THETA) / V)
END

NETWORK
  SET_LEFT: ASSIGN(LEFT_COCKPIT=1)
  TERMINATE()
END
