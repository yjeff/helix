HELIX 1

PROJECT "TANKER FLEET"

VAR TANKER_LEVEL AS "TANKER LEVEL" RANGE 0..300
VAR STORAGE_LEVEL AS "STORAGE LEVEL" RANGE 0..2000
VAR LOAD_AVAIL
VAR UNLOAD_AVAIL
VAR REFINERY_AVAIL

CONTINUOUS METHOD=RK4, MIN_STEP=0.0025, SAVE_STEP=0.25, MAX_STEP=0.25

EQUATION
  DD(TANKER_LEVEL) = -IF(LOAD_AVAIL * UNLOAD_AVAIL * TANKER_LEVEL > 0, 300.0, 0.0)
  DD(STORAGE_LEVEL) = IF(LOAD_AVAIL * UNLOAD_AVAIL * TANKER_LEVEL > 0, 300.0, 0.0) - 150.0 * REFINERY_AVAIL
END

RESOURCE DOCK(capacity=1)

VAR LOAD_START ENTITY
VAR WAIT_START ENTITY

NETWORK
  CREATE(interval=0.5, first=0, count=15)

  VLDZ: ASSIGN(LOAD_START=TNOW)
  VOY: ACTIVITY(duration=UNFRM(2.9, 3.1), servers=15) -> TRANSIT
  TRANSIT: ACTIVITY(duration=RNORM(5.0, 1.5), servers=15) -> WAIT
  WAIT: ASSIGN(WAIT_START=TNOW) -> DOCKWAIT
  DOCKWAIT: AWAIT(resource=DOCK) -> DOCKED
  DOCKED: OBSERVE(name="WAITING TIME", value=TNOW - WAIT_START) -> SETFULL
  SETFULL: ASSIGN(TANKER_LEVEL=150) -> OFFLOAD
  OFFLOAD: ACTIVITY(until=ENDU) -> SETEMPTY
  SETEMPTY: ASSIGN(TANKER_LEVEL=0) -> FREEDOCK
  FREEDOCK: FREE(resource=DOCK) -> RET
  RET: ACTIVITY(duration=RNORM(4.0, 1.0), servers=15) -> TRIP_OBS
  TRIP_OBS: OBSERVE(name="TRIP TIME", value=TNOW - LOAD_START) -> LOOP
  LOOP: ACTIVITY(duration=0, servers=15) -> VLDZ

  SHIFT: CREATE(interval=1.0, first=0.25, until=480)
  SETON: ASSIGN(LOAD_AVAIL=1)
  SHIFTDUR: ACTIVITY(duration=0.75)
  SETOFF: ASSIGN(LOAD_AVAIL=0)
  SHIFTEND: TERMINATE()

  ENDU: DETECT(when=TANKER_LEVEL > 7.5, edge=FALLING) -> ENDSIG
  ENDSIG: TERMINATE()

  REF_OFF: DETECT(when=STORAGE_LEVEL > 5, edge=FALLING) -> REF_OFF_ACT
  REF_OFF_ACT: ASSIGN(REFINERY_AVAIL=0) -> REF_OFF_END
  REF_OFF_END: TERMINATE()

  REF_ON: DETECT(when=STORAGE_LEVEL > 50, edge=RISING) -> REF_ON_ACT
  REF_ON_ACT: ASSIGN(REFINERY_AVAIL=1) -> REF_ON_END
  REF_ON_END: TERMINATE()

  UNLOAD_OFF: DETECT(when=STORAGE_LEVEL > 2000, edge=RISING) -> UOFF_ACT
  UOFF_ACT: ASSIGN(UNLOAD_AVAIL=0) -> UOFF_END
  UOFF_END: TERMINATE()

  UNLOAD_ON: DETECT(when=STORAGE_LEVEL > 1600, edge=FALLING) -> UON_ACT
  UON_ACT: ASSIGN(UNLOAD_AVAIL=1) -> UON_END
  UON_END: TERMINATE()
END
