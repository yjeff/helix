HELIX 1

PROJECT "SOAKING PIT"

; 10 个坑位的数据按数组保存；PIT_INDEX 是当前实体占用的坑位。
VAR TEMP[10] GLOBAL
VAR ACTIVE[10] GLOBAL
VAR C[10] GLOBAL
VAR HEAT_START[10] GLOBAL
VAR FURNACE GLOBAL
VAR MAX_TEMP GLOBAL
VAR PIT_INDEX ENTITY
VAR LOAD_START ENTITY
VAR LOAD_TEMP ENTITY

CONTINUOUS METHOD=RK4, MIN_STEP=0.1, SAVE_STEP=10, MAX_STEP=10

; 任一 ingot 超过 2200 度时，扫描并释放所有达到 2000 度的坑位。
SEVNT name=EXIT, code=2, when=MAX_TEMP > 2200, action=EXIT_SCAN

EQUATION
  SS(MAX_TEMP) = MAX(TEMP[1], TEMP[2], TEMP[3], TEMP[4], TEMP[5],
                     TEMP[6], TEMP[7], TEMP[8], TEMP[9], TEMP[10])

  DD(TEMP[1]) = ((FURNACE - TEMP[1]) * ACTIVE[1]) * C[1]
  DD(TEMP[2]) = ((FURNACE - TEMP[2]) * ACTIVE[2]) * C[2]
  DD(TEMP[3]) = ((FURNACE - TEMP[3]) * ACTIVE[3]) * C[3]
  DD(TEMP[4]) = ((FURNACE - TEMP[4]) * ACTIVE[4]) * C[4]
  DD(TEMP[5]) = ((FURNACE - TEMP[5]) * ACTIVE[5]) * C[5]
  DD(TEMP[6]) = ((FURNACE - TEMP[6]) * ACTIVE[6]) * C[6]
  DD(TEMP[7]) = ((FURNACE - TEMP[7]) * ACTIVE[7]) * C[7]
  DD(TEMP[8]) = ((FURNACE - TEMP[8]) * ACTIVE[8]) * C[8]
  DD(TEMP[9]) = ((FURNACE - TEMP[9]) * ACTIVE[9]) * C[9]
  DD(TEMP[10]) = ((FURNACE - TEMP[10]) * ACTIVE[10]) * C[10]

  DD(FURNACE) = (2600.0 - FURNACE) * 0.2
END

RESOURCE PIT(capacity=10)

NETWORK
  CREATE(interval=EXPON(2.25), first=0)
  ASSIGN(LOAD_START=TNOW, LOAD_TEMP=UNFRM(400, 500))

  ; 先取得 PIT 资源，再在已保证有空位的坑位中登记 ingot。
  WAIT_PIT: AWAIT(resource=PIT)
  OBSERVE(name="WAITING TIME", value=TNOW - LOAD_START)
  ASSIGN(PIT_INDEX=0)
  SCAN PIT IN 1..10
    WHERE ACTIVE[PIT] == 0
    DO ASSIGN(PIT_INDEX=PIT, ACTIVE[PIT]=1,
              TEMP[PIT]=LOAD_TEMP, C[PIT]=RNORM(0.15, 0.01),
              HEAT_START[PIT]=TNOW)
    DO ASSIGN(FURNACE=FURNACE - IF(SUM(ACTIVE) > 1,
                                   (FURNACE - TEMP[PIT]) / SUM(ACTIVE), 0))
    STOP
  END SCAN

  HOLD: ACTIVITY(until=PIT_DONE[PIT_INDEX], servers=10)
  FREE(resource=PIT)
  TERMINATE()

  ; 退出事件：扫描所有达到 2000 度的坑位，清空并逐个触发事件。
  EXIT_SCAN: SCAN PIT IN 1..10
    WHERE TEMP[PIT] >= 2000
    DO OBSERVE(name="HEATING TEMP", value=TEMP[PIT])
    DO OBSERVE(name="HEATING TIME", value=TNOW - HEAT_START[PIT])
    DO ASSIGN(TEMP[PIT]=0, ACTIVE[PIT]=0)
    DO EVENT(name=PIT_DONE[PIT])
  END SCAN
  TERMINATE()
END
