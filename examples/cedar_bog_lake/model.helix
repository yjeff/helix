HELIX 1

PROJECT "CEDAR BOG LAKE"

VAR PLANTS AS "PLANTS"
VAR HERBIVORES AS "HERBIVORES"
VAR CARNIVORES AS "CARNIVORES"
VAR ORGANIC AS "ORGANIC"
VAR ENVIRONMENT AS "ENVIRONMENT"
VAR SOLAR AS "SOLAR ENERGY"

CONTINUOUS METHOD=RKF45, MIN_STEP=0.00025, SAVE_STEP=0.025, MAX_STEP=0.025, TOL=1e-5

EQUATION
  SS(SOLAR) = 95.9 * (1.0 + 0.635 * SIN(2.0 * PI * TNOW))
  DD(PLANTS) = SOLAR - 4.03 * PLANTS
  DD(HERBIVORES) = 0.48 * PLANTS - 17.87 * HERBIVORES
  DD(CARNIVORES) = 4.85 * HERBIVORES - 4.65 * CARNIVORES
  DD(ORGANIC) = 2.55 * PLANTS + 6.12 * HERBIVORES + 1.95 * CARNIVORES
  DD(ENVIRONMENT) = PLANTS + 6.9 * HERBIVORES + 2.7 * CARNIVORES
END
